<UserControl x:Class="XenUpdate.App.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="260">
    <!--
        A self-built saturation/value square + hue strip + hex box, styled with the app's own
        Zen* brushes — replacing System.Windows.Forms.ColorDialog, which the user said reads as
        visibly out of place (unstyled Win32 chrome) against the rest of the glassmorphism UI.
        Purely a "pick a color" widget: SelectedColor is the only thing callers need to bind to.
        Confirm/cancel semantics belong to whoever embeds this (see SettingsView's picker panel),
        not to the control itself.
    -->
    <StackPanel Width="260">
        <Border x:Name="SvBorder" Height="150" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,12"
                Cursor="Cross"
                Background="Transparent"
                MouseLeftButtonDown="SvBorder_OnMouseLeftButtonDown"
                MouseMove="SvBorder_OnMouseMove"
                MouseLeftButtonUp="SvBorder_OnMouseLeftButtonUp"
                LostMouseCapture="SvBorder_OnLostMouseCapture">
            <Grid>
                <!-- Base hue at full saturation/value; overlaid gradients carve out S (white->transparent, left to right) and V (transparent->black, top to bottom). -->
                <Rectangle x:Name="HueBaseRect" />
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="16" Height="16" Margin="-8,-8,0,0"
                             Stroke="White" StrokeThickness="2.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.7" Color="#000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Background=Transparent is load-bearing: a Border with a null Background is not
             hit-testable in WPF, and this border's child rectangles are IsHitTestVisible=False
             (so the thumb never steals the drag) — without it, none of these mouse handlers
             ever fired and the hue strip was completely inert. -->
        <Border x:Name="HueBorder" Height="18" CornerRadius="9" ClipToBounds="True" Margin="0,0,0,14"
                Cursor="Hand"
                Background="Transparent"
                MouseLeftButtonDown="HueBorder_OnMouseLeftButtonDown"
                MouseMove="HueBorder_OnMouseMove"
                MouseLeftButtonUp="HueBorder_OnMouseLeftButtonUp"
                LostMouseCapture="HueBorder_OnLostMouseCapture">
            <Grid>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.167" />
                            <GradientStop Color="#FF00FF00" Offset="0.333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.833" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="7" Height="18" Margin="-3.5,0,0,0"
                            Background="White" CornerRadius="3.5"
                            BorderBrush="#40000000" BorderThickness="1" />
                </Canvas>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                    Background="{Binding SelectedColorBrush, ElementName=Root}"
                    BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="1.5" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!--
                    HintAssist.Hint alone never actually appears here — Material's floating hint
                    only shows once the box is non-empty, and HexText is never empty — so the
                    user had no way to tell this was a hex code rather than RGB numbers. A plain
                    static label above the box says so unconditionally.
                -->
                <TextBlock Text="HEX" FontSize="10" FontWeight="Medium" Opacity="0.55" Margin="2,0,0,3" />
                <!-- Text deliberately NOT bound: code-behind owns it (RefreshVisuals/CommitHexText).
                     A OneWay binding here silently detaches the first time CommitHexText assigns
                     Text directly — a WPF rule, local value replaces a OneWay binding — after
                     which dragging the picker would stop updating the box. -->
                <TextBox x:Name="HexTextBox"
                         materialDesign:HintAssist.Hint="#RRGGBB"
                         KeyDown="HexTextBox_OnKeyDown"
                         LostFocus="HexTextBox_OnLostFocus" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
