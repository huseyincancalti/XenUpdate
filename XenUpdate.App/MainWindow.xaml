<Window x:Class="XenUpdate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
        xmlns:views="clr-namespace:XenUpdate.App.Views"
        xmlns:loc="clr-namespace:XenUpdate.App.Services"
        Title="XenUpdate"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStyle="None"
        Background="{DynamicResource ZenAmbientBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=False}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <!--
                MinHeight (not a fixed Height): the "Guides" item grows taller to fit its
                category sub-branches list below the icon+label row. Ordinary items are
                shorter than 48 anyway, so MinHeight renders them identically to before.
            -->
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenNavItemSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            "Guides" is the one sidebar item whose content owns per-row active state (the
            parent row lights up for the landing, one sub-branch lights up for whichever guide
            is open) via its own nested Borders. If this item ALSO painted its entire block with
            SidebarItemStyle's IsSelected background — which fires as soon as the Guides page is
            merely the active page, regardless of which specific row is "active" — every nested
            row would sit on that same fill color and the per-row highlight would be invisible,
            since it's the identical color painted on top of itself. This style drops the
            IsSelected fill entirely (keeping only hover) so the nested rows are the only source
            of highlight, and are therefore actually visible.
        -->
        <Style x:Key="GuidesSidebarItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
            <!--
                Padding=0: the parent row and sub-branch group below manage their own padding
                independently (the parent row uses the same 14,0 other tabs get; sub-items use
                their own tree-indent), so this outer container must not ALSO add its own 14,0
                on top — that would double the indent and shrink the available content width.
            -->
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!--
                            No IsMouseOver trigger here (unlike the base style): a whole-block
                            hover wash on this Root would paint over/dilute the per-row hover
                            feedback the parent row and each sub-branch already provide on their
                            own, undoing the "which one am I actually pointing at" clarity.
                        -->
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Overview is the flagship landing page, so it gets its own hero-styled item instead
            of sharing SidebarItemStyle's plain rows: bigger, permanently gradient-filled, with
            a white ring appearing only while it's the active page. The Template is fully
            replaced (not just a Setter override) so this needs its own IsMouseOver/IsSelected
            triggers — they aren't inherited from SidebarItemStyle once Template is replaced.
        -->
        <Style x:Key="OverviewSidebarItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Opacity="0.8"
                                BorderThickness="0"
                                BorderBrush="White">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7C3AED" Offset="0" />
                                    <GradientStop Color="#4F46E5" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Order matters — see the comment on GuidesParentRow's style further down. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Uppercase label above each grouped sidebar card (Updates/Guides/Settings) -->
        <Style x:Key="SidebarSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ZenMutedTextBrush}" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="24,16,12,8" />
        </Style>

        <!-- Bounded panel behind each grouped section, so groups read as distinct regions rather than one flat list -->
        <Style x:Key="SidebarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ZenSidebarCardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="12,0,12,4" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- Page VM → View map for the shell content area -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
            <views:ProgramsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsUpdatesViewModel}">
            <views:WindowsUpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PipPackagesViewModel}">
            <views:PipPackagesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareHubViewModel}">
            <views:HardwareHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="AppTrayIcon"
                        Grid.RowSpan="2"
                        IconSource="pack://application:,,,/Assets/AppIcon.ico"
                        ToolTipText="XenUpdate - Background Updater"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <!--
                    A ContextMenu is a separate popup, detached from the visual tree of the
                    control it's attached to — it does NOT reliably inherit DataContext from
                    TaskbarIcon the way a normal child element would. Binding Command here
                    could silently resolve to nothing, so both actions are wired via Click
                    handlers in code-behind instead, which unambiguously read MainWindow's
                    own DataContext.
                -->
                <ContextMenu>
                    <MenuItem Header="Open XenUpdate" Click="OpenMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" Foreground="Red" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ===== Title bar ===== -->
        <Grid Grid.Row="0"
              Background="{DynamicResource ZenDeepBackgroundBrush}"
              TextElement.Foreground="{DynamicResource ZenTextBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="20" Height="20" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="XenUpdate" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Border Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <!-- Offline indicator — visible only when IsOnline=False; non-interactive -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="4" Padding="8,3"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#CC4A2200" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WifiOff" Width="13" Height="13"
                                                 Margin="0,0,5,0" VerticalAlignment="Center"
                                                 Foreground="#FFE89200" />
                        <TextBlock Text="{Binding [NoInternet], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FFE89200" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">

                <Button Command="{Binding DownloadAppUpdateCommand}"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="24" Margin="0,0,10,0" Padding="10,0"
                        FontSize="11" FontWeight="SemiBold" Foreground="White"
                        Background="#E53935" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="{Binding [NewVersionTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ArrowUpCircle" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C62828" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding [NewVersionAvailable], Source={x:Static loc:LocalizationManager.Instance}}" />
                </Button>

                <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" ToolTip="{Binding [MinimizeTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" />
                </Button>

                <Button Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" ToolTip="{Binding [MaximizeTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Width="14" Height="14">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="WindowMaximize" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Kind" Value="WindowRestore" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>

                <Button Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{Binding [CloseTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Body: sidebar + page content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ZenSidebarPanelBrush}"
                    BorderBrush="{DynamicResource ZenDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="40" Height="40" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="XenUpdate"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ZenPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!--
                        Four visually bounded groups instead of one flat list: a hero Overview
                        tile, then Updates/Guides/Settings each behind their own SidebarCardStyle
                        panel with an uppercase header above it. Each group is its OWN ListBox
                        (rather than one ListBox with inline dividers) because that's the only
                        way to put a real Border/background behind a subset of items — a ListBox
                        only lets you style individual item containers, not wrap several of them
                        in a shared panel. All four bind SelectedValue TwoWay to the same
                        SelectedPage property, so selecting an item in any one of them correctly
                        clears the selection (SelectedIndex -1) in the other three.
                    -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,8">

                            <ListBox SelectedValuePath="Tag"
                                     SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     PreviewMouseWheel="SidebarNavList_OnPreviewMouseWheel"
                                     ItemContainerStyle="{StaticResource OverviewSidebarItemStyle}">
                                <ListBoxItem Tag="{x:Static vm:AppPage.Overview}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewDashboard" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [NavOverview], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <TextBlock Text="{Binding [SidebarSectionUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                            <Border Style="{StaticResource SidebarCardStyle}">
                                <StackPanel>
                                    <ListBox SelectedValuePath="Tag"
                                             SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             PreviewMouseWheel="SidebarNavList_OnPreviewMouseWheel"
                                             ItemContainerStyle="{StaticResource SidebarItemStyle}">
                                        <ListBoxItem Tag="{x:Static vm:AppPage.Programs}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [NavPrograms], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="{x:Static vm:AppPage.WindowsUpdates}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MicrosoftWindows" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [NavWindowsUpdates], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="{x:Static vm:AppPage.Drivers}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [NavDrivers], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="{x:Static vm:AppPage.PipPackages}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="LanguagePython" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [NavPipPackages], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>

                                    <!-- Scan All lives here, not as a separate footer — it scans exactly the four pages in this card. -->
                                    <Border Height="1" Background="{DynamicResource ZenDividerBrush}" Opacity="0.6" Margin="10,4,10,10" />
                                    <Button Command="{Binding ScanAllCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="40"
                                            Margin="8,0,8,8"
                                            ToolTip="{Binding [ScanAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                        <Grid>
                                            <!-- Idle: refresh icon + "Scan All" -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScanningAll}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [ScanAll], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Busy: animated spinner + "Scanning…" -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsScanningAll}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="16" Height="16" Margin="0,0,8,0"
                                                             Foreground="White"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding [ScanAllBusy], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding [SidebarSectionGuides], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                            <Border Style="{StaticResource SidebarCardStyle}">
                                <ListBox SelectedValuePath="Tag"
                                         SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         PreviewMouseWheel="SidebarNavList_OnPreviewMouseWheel"
                                         ItemContainerStyle="{StaticResource GuidesSidebarItemStyle}">
                                <ListBoxItem Tag="{x:Static vm:AppPage.HardwareHub}">
                            <StackPanel>
                                <!--
                                    Parent row: solid "classic" highlight when the Guides landing
                                    itself is what's showing, PLUS a soft glow rising from its
                                    bottom edge whenever a child guide (NVIDIA/Visual Studio) is
                                    open instead — so "Guides" always shows some cue that one of
                                    its branches is active, distinct from being active itself.

                                    IMPORTANT: Background is set via a plain Setter (not a local
                                    XAML attribute) — a local value on Background would always
                                    beat the Trigger's Setter for the same property (local values
                                    outrank style triggers in WPF's precedence order), which is
                                    exactly why this highlight silently never appeared before.
                                -->
                                <Border x:Name="GuidesParentRow" MinHeight="48" CornerRadius="8" Padding="14,0"
                                        Cursor="Hand" PreviewMouseLeftButtonDown="GuidesParentRow_OnClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <!--
                                                    Order matters: later triggers win when more than
                                                    one condition is true at once. Hover is listed
                                                    FIRST and "active" LAST, so hovering the item that
                                                    is already active keeps the active highlight
                                                    instead of hover dimming it back to the plain
                                                    hover shade — hovering a non-active row still
                                                    gets the ordinary hover feedback since only that
                                                    one trigger's condition is true in that case.
                                                -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                                                </Trigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedPage}" Value="{x:Static vm:AppPage.HardwareHub}" />
                                                        <Condition Binding="{Binding GuidesViewModel.IsShowingGuideDetail}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource ZenNavItemSelectedBackgroundBrush}" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="MapMarkerPath" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding [NavGuides], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <!--
                                            Glow-from-below, take three. Both earlier attempts had a
                                            real problem, not just a look problem: a flat gradient
                                            rectangle spanning the row's full height/width reads as a
                                            hard bar, and a DropShadowEffect bleeding downward renders
                                            BEHIND the sub-branch panel below it in z-order (that
                                            panel is a later sibling, painted on top), so it was
                                            invisible no matter its color. This version stays fully
                                            INSIDE the row's own bounds — a thin, inset, horizontally
                                            faded strip — so there's nothing below it to occlude it,
                                            and the fade-to-transparent at both ends plus the small
                                            height read as a soft accent rather than a slab.
                                        -->
                                        <Border VerticalAlignment="Bottom" Height="3" Margin="14,0,14,3" CornerRadius="1.5"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding GuidesViewModel.IsShowingGuideDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Transparent" Offset="0" />
                                                    <GradientStop Color="#7C3AED" Offset="0.5" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!--
                                    Sub-branches hang off a vertical trunk line (like a tree/git
                                    graph) so they read as literally connected to "Guides". Each
                                    active row gets a solid fill + left accent bar (same as above,
                                    set via Setter — not a local attribute, for the same reason)
                                    plus a one-shot light sweep that plays left-to-right the moment
                                    it becomes the active one, so switching between NVIDIA and
                                    Visual Studio is unmistakable, not just a static color change.
                                -->
                                <Border Visibility="{Binding GuidesViewModel.HasGuides, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        BorderBrush="{DynamicResource ZenDividerBrush}"
                                        BorderThickness="1.5,0,0,0"
                                        Margin="17,6,6,2"
                                        Padding="10,2,0,2">
                                    <ItemsControl ItemsSource="{Binding GuidesViewModel.SidebarGuides}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!--
                                                    PreviewMouseLeftButtonDown (not Up, and not Click since
                                                    these aren't buttons): ListBoxItem selects on mouse-DOWN,
                                                    not mouse-up. Wiring this on Up meant IsShowingGuideDetail
                                                    only flipped to True a whole click-cycle AFTER SelectedPage
                                                    had already become HardwareHub — a brief window where the
                                                    parent "Guides" row's own MultiDataTrigger (SelectedPage==
                                                    HardwareHub AND IsShowingGuideDetail==False) was genuinely
                                                    satisfied, flashing its highlight before this handler caught
                                                    up. Firing on Down instead means this state updates before
                                                    the ListBoxItem's own bubbling selection change even starts.
                                                -->
                                                <Border CornerRadius="6" Padding="8,7" Margin="0,1,0,1"
                                                        BorderThickness="3,0,0,0"
                                                        ClipToBounds="True"
                                                        Cursor="Hand" PreviewMouseLeftButtonDown="GuideSidebarItem_OnClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <!-- Order matters here too — see the comment on GuidesParentRow's style above. -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsActive}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.SelectedPage, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="{x:Static vm:AppPage.HardwareHub}" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource ZenNavItemSelectedBackgroundBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <!--
                                                        No more sweep animation here — it used to play a
                                                        one-shot light streak across this TextBlock via a
                                                        Storyboard animating a nested RenderTransform. That
                                                        animation intermittently crashed the whole app with
                                                        a XamlParseException ("cannot animate '(0).(1)' on a
                                                        frozen Freezable instance") when switching between
                                                        sub-branches, logged to %APPDATA%\XenUpdate\logs.txt.
                                                        The solid background/border highlight above already
                                                        conveys "this one is active" on its own — removed the
                                                        animation rather than keep chasing a decorative extra.
                                                    -->
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Opacity="0.9"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                                </ListBoxItem>
                                </ListBox>
                            </Border>

                            <TextBlock Text="{Binding [SidebarSectionSettings], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Style="{StaticResource SidebarSectionHeaderStyle}" />
                            <Border Style="{StaticResource SidebarCardStyle}">
                                <ListBox SelectedValuePath="Tag"
                                         SelectedValue="{Binding SelectedPage, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         PreviewMouseWheel="SidebarNavList_OnPreviewMouseWheel"
                                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                                    <ListBoxItem Tag="{x:Static vm:AppPage.Settings}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding [NavSettings], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Offline dim overlay — gently darkens the body to signal that the network is down -->
        <Rectangle Grid.Row="1"
                   Panel.ZIndex="500"
                   Fill="#44000000"
                   IsHitTestVisible="False">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <materialDesign:Snackbar x:Name="MainSnackbar"
                                 Grid.RowSpan="2"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Panel.ZIndex="10000"
                                 MessageQueue="{materialDesign:MessageQueue}" />
    </Grid>
</Window>
