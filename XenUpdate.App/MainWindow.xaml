<Window x:Class="XenUpdate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
        xmlns:views="clr-namespace:XenUpdate.App.Views"
        xmlns:loc="clr-namespace:XenUpdate.App.Services"
        Title="XenUpdate"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Height="720"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStyle="None"
        Background="{DynamicResource ZenAmbientBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel, IsDesignTimeCreatable=False}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource ZenTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenNavItemSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page VM → View map for the shell content area -->
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
            <views:ProgramsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsUpdatesViewModel}">
            <views:WindowsUpdatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}">
            <views:DriversView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareHubViewModel}">
            <views:HardwareHubView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="AppTrayIcon"
                        Grid.RowSpan="2"
                        IconSource="pack://application:,,,/Assets/AppIcon.ico"
                        ToolTipText="XenUpdate - Background Updater"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <!--
                    A ContextMenu is a separate popup, detached from the visual tree of the
                    control it's attached to — it does NOT reliably inherit DataContext from
                    TaskbarIcon the way a normal child element would. Binding Command here
                    could silently resolve to nothing, so both actions are wired via Click
                    handlers in code-behind instead, which unambiguously read MainWindow's
                    own DataContext.
                -->
                <ContextMenu>
                    <MenuItem Header="Open XenUpdate" Click="OpenMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" Foreground="Red" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ===== Title bar ===== -->
        <Grid Grid.Row="0"
              Background="{DynamicResource ZenDeepBackgroundBrush}"
              TextElement.Foreground="{DynamicResource ZenTextBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="pack://application:,,,/Assets/logo.png"
                       Width="20" Height="20" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="XenUpdate" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Border Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <!-- Offline indicator — visible only when IsOnline=False; non-interactive -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="4" Padding="8,3"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="#CC4A2200" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WifiOff" Width="13" Height="13"
                                                 Margin="0,0,5,0" VerticalAlignment="Center"
                                                 Foreground="#FFE89200" />
                        <TextBlock Text="{Binding [NoInternet], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FFE89200" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        WindowChrome.IsHitTestVisibleInChrome="True">

                <Button Command="{Binding DownloadAppUpdateCommand}"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="24" Margin="0,0,10,0" Padding="10,0"
                        FontSize="11" FontWeight="SemiBold" Foreground="White"
                        Background="#E53935" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="{Binding [NewVersionTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ArrowUpCircle" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C62828" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{Binding [NewVersionAvailable], Source={x:Static loc:LocalizationManager.Instance}}" />
                </Button>

                <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeButton_Click" ToolTip="{Binding [MinimizeTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" />
                </Button>

                <Button Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeButton_Click" ToolTip="{Binding [MaximizeTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Width="14" Height="14">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="WindowMaximize" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Kind" Value="WindowRestore" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Button>

                <Button Style="{StaticResource WindowCloseButtonStyle}" Click="CloseButton_Click" ToolTip="{Binding [CloseTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Body: sidebar + page content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ZenSidebarPanelBrush}"
                    BorderBrush="{DynamicResource ZenDividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,22,20,18">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="40" Height="40" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="XenUpdate"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource ZenPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox x:Name="NavList"
                             Grid.Row="1"
                             SelectedIndex="0"
                             SelectionChanged="NavList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}">
                        <ListBoxItem Tag="{x:Static vm:AppPage.Programs}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [NavPrograms], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static vm:AppPage.WindowsUpdates}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftWindows" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [NavWindowsUpdates], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static vm:AppPage.Drivers}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [NavDrivers], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static vm:AppPage.HardwareHub}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerPath" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [NavGuides], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="{x:Static vm:AppPage.Settings}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [NavSettings], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2" Margin="14,0,14,18">
                        <Button Command="{Binding ScanAllCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="44"
                                ToolTip="{Binding [ScanAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <Grid>
                                <!-- Idle: refresh icon + "Scan All" -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningAll}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ScanAll], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Busy: animated spinner + "Scanning…" -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningAll}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True"
                                                 Width="18" Height="18" Margin="0,0,8,0"
                                                 Foreground="White"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [ScanAllBusy], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- Offline dim overlay — gently darkens the body to signal that the network is down -->
        <Rectangle Grid.Row="1"
                   Panel.ZIndex="500"
                   Fill="#44000000"
                   IsHitTestVisible="False">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <materialDesign:Snackbar x:Name="MainSnackbar"
                                 Grid.RowSpan="2"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Panel.ZIndex="10000"
                                 MessageQueue="{materialDesign:MessageQueue}" />
    </Grid>
</Window>
