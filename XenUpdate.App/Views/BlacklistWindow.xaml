<Window x:Class="XenUpdate.App.Views.BlacklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:XenUpdate.App.Services"
        xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
        Title="Blacklist Manager"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Border MinWidth="500"
            MaxWidth="640"
            CornerRadius="16"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            TextElement.Foreground="{DynamicResource MaterialDesignBody}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesignToolBarBackground}"
                    CornerRadius="16,16,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLock"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="{Binding [BlacklistManager], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32" Padding="0"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- Items list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,12,20,0"
                          MinHeight="60"
                          MaxHeight="320">
                <ItemsControl ItemsSource="{Binding BlacklistedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="12,8"
                                            CornerRadius="8"
                                            Background="{DynamicResource MaterialDesignChipBackground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PackageId}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Reason}"
                                                   Opacity="0.6"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.RemoveFromBlacklistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="30" Height="30" Padding="0"
                                            Foreground="#E53935"
                                            ToolTip="Remove">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="{Binding [NoHiddenUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                       HorizontalAlignment="Center"
                       Margin="0,24"
                       Opacity="0.55">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BlacklistedItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Separator Grid.Row="2" Margin="20,8" Opacity="0.25" />

            <!-- Add entry -->
            <Grid Grid.Row="3" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding NewBlacklistId, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{Binding [PackageIdHint], Source={x:Static loc:LocalizationManager.Instance}}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddManualBlacklistCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Command="{Binding AddManualBlacklistCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="40"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [Add], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
