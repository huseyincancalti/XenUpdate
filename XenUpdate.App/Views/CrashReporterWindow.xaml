<Window x:Class="XenUpdate.App.Views.CrashReporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="XenUpdate - Crash Reporter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">

    <Border Width="500"
            CornerRadius="16"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="#E53935"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Draggable header -->
            <Border Grid.Row="0"
                    Background="#E53935"
                    CornerRadius="14,14,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOctagon"
                                             Width="22" Height="22"
                                             Foreground="White"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                    <TextBlock Text="XenUpdate Crash Reporter"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Message -->
            <StackPanel Grid.Row="1" Margin="22,20,22,10" HorizontalAlignment="Center">
                <TextBlock Text="Oops! XenUpdate ran into a problem."
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="The error details are shown below. You can copy them to share with support."
                           FontSize="12"
                           Opacity="0.7"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- Stack trace -->
            <TextBox x:Name="StackTraceBox"
                     Grid.Row="2"
                     Margin="18,0,18,14"
                     Height="150"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     FontSize="11"
                     Background="#0AFFFFFF"
                     BorderThickness="1"
                     Padding="8" />

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="18,4,18,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="CopyError_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy Error for Support" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Click="Restart_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Restart" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
