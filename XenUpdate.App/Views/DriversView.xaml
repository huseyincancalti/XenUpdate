<UserControl x:Class="XenUpdate.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:XenUpdate.App.Services">
    <Grid Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding [DriversTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />

            <!--
                Action toolbar sits top-right, away from the grid's select-all checkbox
                (top-left of the DataGrid header below). It used to sit directly above that
                checkbox, so a click aimed at "select all" could misfire into "Scan".
                Only the two permanent buttons live here — Cancel and the scan progress bar
                used to sit in this same row and, by appearing/disappearing, changed this
                Auto-width column's total size and shoved these buttons sideways. They now
                live in their own row (Grid.Row="1") below, which can grow or shrink without
                touching this row's layout at all.
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding [ScanForDriverUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0" />

                <Button Content="{Binding [InstallSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding InstallSelectedCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
        </Grid>

        <!--
            Scan-busy row: a spinner + "Scanning…" label, then Cancel. Kept out of the row
            above so their appearing/disappearing never shifts the permanent action buttons.
            A circular spinner (not a thin linear bar) plus explicit text: a slim indeterminate
            line reads as "a barely-visible sliver" at a glance, which is exactly what a user
            reported — this is unambiguous even glanced at quickly. Bound to IsScanning only —
            install progress uses the dedicated feedback panel further down instead.
        -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="18" Height="18"
                             Foreground="{DynamicResource ZenPrimaryBrush}"
                             Margin="0,0,8,0" />
                <TextBlock Text="{Binding [ScanningShort], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="13" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ScanProgressPercent, StringFormat={}{0}%}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ZenPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                    Command="{Binding CancelScanCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!--
            The inline install-batch progress panel that used to live here is now shown live in
            the Update Queue popup window instead — see ShellViewModel.UpdateQueue /
            Views/UpdateQueueWindow.xaml. Keeping both would just duplicate the same information.
        -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource ZenDataGridChromeStyle}"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid x:Name="DriversDataGrid"
                      ItemsSource="{Binding Updates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource ZenDataGridSurfaceBrush}"
                      Foreground="{DynamicResource ZenTextBrush}"
                      ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ZenDataGridRowStyle}"
                      CellStyle="{StaticResource ZenDataGridCellStyle}"
                      PreviewMouseRightButtonDown="DriversDataGrid_OnPreviewMouseRightButtonDown"
                      PreviewMouseLeftButtonUp="DriversDataGrid_OnPreviewMouseLeftButtonUp"
                      materialDesign:DataGridAssist.CellPadding="8 6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="DriversContextMenu_OnOpened">
                        <MenuItem x:Name="CopyErrorMessageMenuItem"
                                  Header="{Binding [CtxCopyErrorMessage], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyErrorMessageMenuItem_OnClick" />
                        <MenuItem x:Name="CopyDriverTitleMenuItem"
                                  Header="{Binding [CtxCopyDriverTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyDriverTitleMenuItem_OnClick" />
                        <MenuItem x:Name="CopyDriverManufacturerMenuItem"
                                  Header="{Binding [CtxCopyManufacturer], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyDriverManufacturerMenuItem_OnClick" />
                        <MenuItem x:Name="CopyDriverTitleAndManufacturerMenuItem"
                                  Header="{Binding [CtxCopyDriverTitleAndManufacturer], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyDriverTitleAndManufacturerMenuItem_OnClick" />
                        <MenuItem x:Name="CopySelectedDriverTitlesMenuItem"
                                  Header="{Binding [CtxCopySelectedTitles], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopySelectedDriverTitlesMenuItem_OnClick" />
                        <Separator />
                        <MenuItem x:Name="AddToWhitelistMenuItem"
                                  Header="{Binding [CtxAddToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveFromWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="AddSelectedToWhitelistMenuItem"
                                  Header="{Binding [CtxAddSelectedToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddSelectedToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveSelectedFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveSelectedFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveSelectedFromWhitelistMenuItem_OnClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!--
                        Template column, not DataGridCheckBoxColumn: the checkbox itself is
                        hit-test invisible, and DriversDataGrid_OnPreviewMouseLeftButtonUp makes
                        the whole row the click target instead — matching Programs/Python
                        Packages, where clicking anywhere on a row toggles it. The previous
                        directly-clickable checkbox column meant only that ~16px glyph responded
                        to clicks, which read as inconsistent (and broken) next to the other pages.
                    -->
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Style="{StaticResource ZenSelectAllCheckBoxStyle}"
                                      IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      IsThreeState="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding [SelectAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColDriverDevice], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="*"
                                            IsReadOnly="True"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Star" Width="13" Height="13"
                                                              Foreground="#FFC107"
                                                              VerticalAlignment="Top"
                                                              Margin="0,3,5,0"
                                                              Visibility="{Binding IsWhitelisted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="{Binding [WhitelistBadgeTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Padding="2,0"
                                                   ToolTip="{Binding DisplayName}" />
                                        <ContentPresenter x:Name="FailurePresenter"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource FailureReasonInlineTemplate}"
                                                          Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="FailurePresenter" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColManufacturer], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="190"
                                            IsReadOnly="True"
                                            SortMemberPath="Manufacturer">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Manufacturer}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding Manufacturer}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColDeviceClass], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="150"
                                            IsReadOnly="True"
                                            SortMemberPath="DeviceClass">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeviceClass}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding DeviceClass}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColStatus], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="110"
                                            IsReadOnly="True"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource StatusBadgeCellTemplate}" />
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <!-- First-scan skeleton: ghost rows while scanning with nothing to show yet (style owns its own visibility logic) -->
            <ContentControl Style="{StaticResource ZenScanSkeletonStyle}" />

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Padding="24"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [DriversEmptyTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [DriversEmptyBody], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Opacity="0.6"
                   Margin="0,8,0,0"
                   FontSize="12" />
    </Grid>
</UserControl>
