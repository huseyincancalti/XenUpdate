<UserControl x:Class="XenUpdate.App.Views.HardwareHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HardwareHubViewModel, IsDesignTimeCreatable=False}"
             Loaded="HardwareHubView_OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="Update Guides" Style="{StaticResource PageTitleStyle}" />

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,0,0,12"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Detected hardware -->
            <TextBlock Text="Detected hardware" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <Border Style="{StaticResource ZenGlassPanelStyle}" Width="300" Padding="20" Margin="0,0,16,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="Gpu" Width="22" Height="22"
                                                     Foreground="{DynamicResource ZenPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.GpuName, FallbackValue='Detecting…'}"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource ZenNavItemSelectedBackgroundBrush}"
                                CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Hardware.GpuVendor, FallbackValue='Unknown'}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ZenGlassPanelStyle}" Width="300" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="22" Height="22"
                                                     Foreground="{DynamicResource ZenPrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.CpuName, FallbackValue='Detecting…'}"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Recommended guides -->
            <TextBlock Text="Recommended guides" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Guides}"
                          Visibility="{Binding HasGuides, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ZenGlassPanelStyle}" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Border Grid.Column="1"
                                            Background="#2E7D32" CornerRadius="6" Padding="9,3"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Check" Width="14" Height="14"
                                                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="Done" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding Why}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"
                                                                         Opacity="0.5" VerticalAlignment="Top" Margin="0,1,8,0" />
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.OpenGuideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Open official page" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Setter Property="Content" Value="Mark as done" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Content" Value="Mark as not done" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border Style="{StaticResource ZenGlassPanelStyle}" Padding="24"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="No guided updates apply right now" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Opacity="0.75" TextWrapping="Wrap"
                               Text="When your hardware needs a manual update (GPU, BIOS, firmware) that Windows can't handle automatically, step-by-step guides will appear here." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.6" FontSize="12" Margin="0,12,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
