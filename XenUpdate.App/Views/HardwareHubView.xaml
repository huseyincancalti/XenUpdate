<UserControl x:Class="XenUpdate.App.Views.HardwareHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HardwareHubViewModel, IsDesignTimeCreatable=False}"
             Loaded="HardwareHubView_OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Hardware Hub"
                   Style="{StaticResource PageTitleStyle}" />

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,12"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Detected hardware -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Width="300"
                    Padding="20"
                    Margin="0,0,16,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="Gpu"
                                                 Width="22" Height="22"
                                                 Foreground="{DynamicResource ZenPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding Hardware.GpuName, FallbackValue='Detecting…'}"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <Border Background="{DynamicResource ZenNavItemSelectedBackgroundBrush}"
                            CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Hardware.GpuVendor, FallbackValue='Unknown'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Width="300"
                    Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="Cpu64Bit"
                                                 Width="22" Height="22"
                                                 Foreground="{DynamicResource ZenPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding Hardware.CpuName, FallbackValue='Detecting…'}"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Seed for the upcoming guided manual-update center -->
        <Border Grid.Row="3"
                Style="{StaticResource ZenGlassPanelStyle}"
                Padding="24"
                VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="MapMarkerPath"
                                             Width="22" Height="22"
                                             Foreground="{DynamicResource ZenPrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Guided updates" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                           Text="Device-specific manual update guides (GPU, BIOS, firmware) will appear here, matched to your detected hardware." />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Opacity="0.65"
                   FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</UserControl>
