<Window x:Class="XenUpdate.App.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
        xmlns:views="clr-namespace:XenUpdate.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Application Log"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        PreviewMouseMove="LogViewerWindow_OnPreviewMouseMove"
        d:DataContext="{d:DesignInstance vm:LogConsoleViewModel, IsDesignTimeCreatable=False}">

    <!--
        Uses the app's own Zen* brushes throughout — this window previously fell back to raw
        stock MaterialDesignThemes resources (MaterialDesignPaper, MaterialDesignToolBarBackground,
        MaterialDesignBody), none of which this app ever overrides, so it rendered as an unstyled
        generic dark panel that clashed badly with the rest of the UI. ZenLogDrawerMatteBrush is
        used deliberately here (rather than a glass/translucent panel) — flat and fully opaque so
        log text stays readable regardless of what's behind the window.
    -->
    <Border Width="620"
            CornerRadius="16"
            Background="{DynamicResource ZenLogDrawerMatteBrush}"
            BorderBrush="{DynamicResource ZenDividerBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="340" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Spotlight only — no photo/scrim (ShowPhotoBackdrop/ShowAmbientFallback both
                false), so it needs an AppSettings DataContext only for SpotlightEnabled; set
                explicitly in code-behind since this window's own DataContext is
                LogConsoleViewModel, not AppSettings. Sits behind the readable content Grid
                below, so it never risks the readability this window was already fixed for.
            -->
            <views:AppBackgroundLayer x:Name="BackgroundLayer"
                                       Grid.RowSpan="3"
                                       ShowPhotoBackdrop="False"
                                       ShowAmbientFallback="False" />

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ZenDeepBackgroundBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TextBoxSearch"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource ZenPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="Application Log"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ZenTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32" Padding="0"
                            Foreground="{DynamicResource ZenMutedTextBrush}"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- Log list: newest entry first, severity-colored left accent + timestamp -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="10,8">
                <ItemsControl x:Name="LogList" ItemsSource="{Binding Entries}">
                    <ItemsControl.Resources>
                        <Style TargetType="Border" x:Key="LogEntryAccentStyle">
                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                            <Setter Property="Padding" Value="9,5" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ZenMutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZenWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ZenErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LogEntryAccentStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource ZenMutedTextBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               FontSize="11"
                                               Foreground="{DynamicResource ZenTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="16,10,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Click="CopyAll_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Copy All" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ClearEntriesCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Clear" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
