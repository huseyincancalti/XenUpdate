<UserControl x:Class="XenUpdate.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
             xmlns:loc="clr-namespace:XenUpdate.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OverviewViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <ScrollViewer.RenderTransform>
            <TranslateTransform />
        </ScrollViewer.RenderTransform>
        <ScrollViewer.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </ScrollViewer.Triggers>
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="{Binding [OverviewTitle], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource PageTitleStyle}" />

            <!--
                Welcome banner — was a hardcoded #7C3AED/#4F46E5 gradient (the app's original
                built-in violet), so it stayed purple no matter what accent/palette the user
                picked in Settings. ZenPrimaryColor/ZenSecondaryColor are the raw Color resources
                ThemeService.ApplyPalette keeps in sync with the chosen palette specifically for
                cases like this (GradientStop.Color can't bind to a Brush resource), so this now
                follows the live palette the same way the sidebar's selected-nav gradient does.
            -->
            <Border CornerRadius="14" Padding="26" Margin="0,0,0,26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource ZenPrimaryColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource ZenSecondaryColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="{Binding [OverviewWelcome], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [OverviewIntro], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="13" Foreground="White" TextWrapping="Wrap" Opacity="0.9" />
                </StackPanel>
            </Border>

            <!-- Detected hardware -->
            <TextBlock Text="{Binding [OverviewDetectedHardware], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                <Border Style="{StaticResource ZenGlassPanelStyle}" Width="280" Padding="18" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="Gpu" Width="20" Height="20" Foreground="{DynamicResource ZenPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold" Opacity="0.65" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.GpuName, FallbackValue='…'}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Background="{DynamicResource ZenNavItemSelectedBackgroundBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Hardware.GpuVendor, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ZenGlassPanelStyle}" Width="280" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="20" Height="20" Foreground="{DynamicResource ZenPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" Opacity="0.65" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.CpuName, FallbackValue='…'}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- What needs attention: clickable quick-access stat cards -->
            <TextBlock Text="{Binding [OverviewQuickStats], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,10" />
            <ItemsControl Margin="0,0,0,28">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Style="{StaticResource ZenGuideEntryCardStyle}" Width="205" Padding="18" Margin="0,0,14,14"
                        Tag="{x:Static vm:AppPage.Programs}" PreviewMouseLeftButtonUp="StatCard_OnClick">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22" Foreground="{DynamicResource ZenPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [NavPrograms], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ProgramsSummary}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ZenGuideEntryCardStyle}" Width="205" Padding="18" Margin="0,0,14,14"
                        Tag="{x:Static vm:AppPage.WindowsUpdates}" PreviewMouseLeftButtonUp="StatCard_OnClick">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="MicrosoftWindows" Width="22" Height="22" Foreground="{DynamicResource ZenPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [NavWindowsUpdates], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding WindowsUpdatesSummary}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ZenGuideEntryCardStyle}" Width="205" Padding="18" Margin="0,0,14,14"
                        Tag="{x:Static vm:AppPage.Drivers}" PreviewMouseLeftButtonUp="StatCard_OnClick">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Cpu64Bit" Width="22" Height="22" Foreground="{DynamicResource ZenPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [NavDrivers], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding DriversSummary}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ZenGuideEntryCardStyle}" Width="205" Padding="18" Margin="0,0,14,14"
                        Tag="{x:Static vm:AppPage.PipPackages}" PreviewMouseLeftButtonUp="StatCard_OnClick">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="LanguagePython" Width="22" Height="22" Foreground="{DynamicResource ZenPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [NavPipPackages], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PipPackagesSummary}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ZenGuideEntryCardStyle}" Width="205" Padding="18" Margin="0,0,14,14"
                        Tag="{x:Static vm:AppPage.HardwareHub}" PreviewMouseLeftButtonUp="StatCard_OnClick">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="MapMarkerPath" Width="22" Height="22" Foreground="{DynamicResource ZenPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding [NavGuides], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding GuidesSummary}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <!-- Quick-start: what does this app actually do -->
            <TextBlock Text="{Binding [OverviewHowToUse], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,10" />
            <Border Style="{StaticResource ZenGlassPanelStyle}" Padding="6" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,14,16,14">
                        <materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18" Foreground="{DynamicResource ZenMutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding [OverviewTipProgramsTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [OverviewTipProgramsBody], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource ZenDividerBrush}" Margin="16,0" />

                    <StackPanel Orientation="Horizontal" Margin="16,14,16,14">
                        <materialDesign:PackIcon Kind="MicrosoftWindows" Width="18" Height="18" Foreground="{DynamicResource ZenMutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding [OverviewTipWindowsUpdatesTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [OverviewTipWindowsUpdatesBody], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource ZenDividerBrush}" Margin="16,0" />

                    <StackPanel Orientation="Horizontal" Margin="16,14,16,14">
                        <materialDesign:PackIcon Kind="Cpu64Bit" Width="18" Height="18" Foreground="{DynamicResource ZenMutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding [OverviewTipDriversTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [OverviewTipDriversBody], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource ZenDividerBrush}" Margin="16,0" />

                    <StackPanel Orientation="Horizontal" Margin="16,14,16,14">
                        <materialDesign:PackIcon Kind="LanguagePython" Width="18" Height="18" Foreground="{DynamicResource ZenMutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding [OverviewTipPipPackagesTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [OverviewTipPipPackagesBody], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource ZenDividerBrush}" Margin="16,0" />

                    <StackPanel Orientation="Horizontal" Margin="16,14,16,14">
                        <materialDesign:PackIcon Kind="MapMarkerPath" Width="18" Height="18" Foreground="{DynamicResource ZenMutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding [OverviewTipGuidesTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [OverviewTipGuidesBody], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
