<UserControl x:Class="XenUpdate.App.Views.PipPackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:XenUpdate.App.Services">
    <!--
        DataContext is set automatically by MainWindow's DataTemplate binding.
        DataContext type: PipPackagesViewModel
    -->
    <Grid Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding [PipPackagesTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />

            <!--
                Action toolbar sits top-right, away from the grid's select-all checkbox
                (top-left of the DataGrid header below). It used to sit directly above that
                checkbox, so a click aimed at "select all" could misfire into "Scan".
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="{Binding [ScanForPipUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0" />

                <Button Content="{Binding [UpdateSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding InstallSelectedCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" />

                <Button Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding CancelScanCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--
                    Scan-only thin progress bar.
                    Bound to IsScanning so it stays hidden while installs run;
                    install progress is shown by the dedicated feedback panel below.
                -->
                <ProgressBar IsIndeterminate="True"
                             Width="120"
                             Height="4"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />

            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource ZenGlassPanelStyle}"
                Margin="0,0,0,12"
                Padding="12"
                Visibility="{Binding IsInstallBatchRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding CurrentBatchProgressText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentPackageName, StringFormat=Current package: {0}}"
                           Margin="0,0,0,6" />
                <ProgressBar IsIndeterminate="True"
                             Height="6"
                             Margin="0,0,0,6" />
                <TextBlock Text="{Binding CurrentInstallDetailText}"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource ZenDataGridChromeStyle}"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid x:Name="PipPackagesDataGrid"
                      ItemsSource="{Binding Updates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource ZenDataGridSurfaceBrush}"
                      Foreground="{DynamicResource ZenTextBrush}"
                      ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ZenDataGridRowStyle}"
                      CellStyle="{StaticResource ZenDataGridCellStyle}"
                      PreviewMouseRightButtonDown="PipPackagesDataGrid_OnPreviewMouseRightButtonDown"
                      materialDesign:DataGridAssist.CellPadding="8 6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="PipPackagesContextMenu_OnOpened">
                        <MenuItem x:Name="CopyPackageNameMenuItem"
                                  Header="{Binding [CtxCopyPackageName], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyPackageNameMenuItem_OnClick" />
                        <MenuItem x:Name="CopySelectedPackageNamesMenuItem"
                                  Header="{Binding [CtxCopySelectedPackageNames], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopySelectedPackageNamesMenuItem_OnClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>

                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Style="{StaticResource ZenSelectAllCheckBoxStyle}"
                                      IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      IsThreeState="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding [SelectAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColPackageName], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="*"
                                            MinWidth="160"
                                            IsReadOnly="True"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Padding="2,0"
                                               ToolTip="{Binding DisplayName}" />
                                    <ContentPresenter x:Name="FailurePresenter"
                                                      Content="{Binding}"
                                                      ContentTemplate="{StaticResource FailureReasonInlineTemplate}"
                                                      Visibility="Collapsed" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="FailurePresenter" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{Binding [ColCurrentVer], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Binding="{Binding CurrentVersion}"
                                        Width="130"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="{Binding [ColNewVer], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Binding="{Binding AvailableVersion}"
                                        Width="130"
                                        IsReadOnly="True" />

                    <DataGridTemplateColumn Header="{Binding [ColStatus], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="110"
                                            IsReadOnly="True"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource StatusBadgeCellTemplate}" />

                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Padding="24"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [PipPackagesEmptyTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [PipPackagesEmptyBody], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Opacity="0.65"
                   FontSize="12"
                   Margin="0,8,0,0" />

    </Grid>
</UserControl>
