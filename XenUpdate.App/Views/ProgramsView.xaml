<UserControl x:Class="XenUpdate.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:XenUpdate.App.Services">
    <!--
        DataContext is set automatically by MainWindow's DataTemplate binding.
        DataContext type: ProgramsViewModel
    -->
    <Grid Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding [ProgramsTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />

            <!--
                Action toolbar sits top-right, away from the grid's select-all checkbox
                (top-left of the DataGrid header below). It used to sit directly above that
                checkbox, so a click aimed at "select all" could misfire into "Scan".
                Only the two permanent buttons live here — Cancel and the scan progress bar
                used to sit in this same row and, by appearing/disappearing, changed this
                Auto-width column's total size and shoved these buttons sideways. They now
                live in their own row (Grid.Row="1") below, which can grow or shrink without
                touching this row's layout at all.
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="{Binding [ScanForUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="14,8"
                        Margin="0,0,8,0" />

                <Button Content="{Binding [UpdateSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding InstallSelectedCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,8" />

            </StackPanel>
        </Grid>

        <!--
            Scan-busy row: a spinner + "Scanning…" label, then Cancel. Kept out of the row
            above so their appearing/disappearing never shifts the permanent action buttons.
            A circular spinner (not a thin linear bar) plus explicit text: a slim indeterminate
            line reads as "a barely-visible sliver" at a glance, which is exactly what a user
            reported — this is unambiguous even glanced at quickly. Bound to IsScanning only —
            install/update progress uses the dedicated feedback panel further down instead.
        -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="18" Height="18"
                             Foreground="{DynamicResource ZenPrimaryBrush}"
                             Margin="0,0,8,0" />
                <TextBlock Text="{Binding [ScanningShort], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="13" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ScanProgressPercent, StringFormat={}{0}%}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ZenPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                    Command="{Binding CancelScanCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,8"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource ZenGlassPanelStyle}"
                Margin="0,0,0,14"
                Padding="14"
                Visibility="{Binding IsUpdateBatchRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding CurrentBatchProgressText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="1"
                           Text="{Binding OverallProgressPercent, StringFormat=Overall progress: {0}%}"
                           Opacity="0.78"
                           FontSize="12"
                           Margin="0,0,0,6" />

                <ProgressBar Grid.Row="2"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding OverallProgressPercent}"
                             Margin="0,0,0,10" />

                <TextBlock Grid.Row="3"
                           Text="{Binding CurrentAppName, StringFormat=Current app: {0}}"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="4"
                           Text="{Binding CurrentInstallDetailText}"
                           Opacity="0.7"
                           FontSize="12"
                           Margin="0,0,0,6" />

                <StackPanel Grid.Row="5">
                    <TextBlock Text="{Binding CurrentItemProgressText}"
                               Opacity="0.78"
                               FontSize="12"
                               Margin="0,0,0,6" />
                    <ProgressBar Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding CurrentItemProgressPercent}"
                                 IsIndeterminate="{Binding IsCurrentItemProgressIndeterminate}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <!--
                Virtualization flags keep scrolling smooth for large result sets:
                  - IsVirtualizing + Recycling: only visible rows are realized, containers reused.
                  - ScrollUnit="Pixel": smooth pixel scroll instead of row-jump.
                  - EnableRowVirtualization/EnableColumnVirtualization: DataGrid-specific toggles.
                DataGrid body stays solid (MaterialDesignPaper) for row readability; only the
                outer chrome uses the glass-tinted frame.
            -->
            <Border Style="{StaticResource ZenDataGridChromeStyle}"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid x:Name="ProgramsDataGrid"
                      ItemsSource="{Binding Updates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource ZenDataGridSurfaceBrush}"
                      Foreground="{DynamicResource ZenTextBrush}"
                      ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ZenDataGridRowStyle}"
                      CellStyle="{StaticResource ZenDataGridCellStyle}"
                      PreviewMouseRightButtonDown="ProgramsDataGrid_OnPreviewMouseRightButtonDown"
                      PreviewMouseLeftButtonUp="ProgramsDataGrid_OnPreviewMouseLeftButtonUp"
                      materialDesign:DataGridAssist.CellPadding="8 6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="ProgramsContextMenu_OnOpened">
                        <MenuItem x:Name="CopyPackageIdMenuItem"
                                  Header="{Binding [CtxCopyPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyPackageIdMenuItem_OnClick" />
                        <MenuItem x:Name="CopyAppNameMenuItem"
                                  Header="{Binding [CtxCopyAppName], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyAppNameMenuItem_OnClick" />
                        <MenuItem x:Name="CopyAppNameAndPackageIdMenuItem"
                                  Header="{Binding [CtxCopyAppNameAndId], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyAppNameAndPackageIdMenuItem_OnClick" />
                        <MenuItem x:Name="CopySelectedPackageIdsMenuItem"
                                  Header="{Binding [CtxCopySelectedIds], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopySelectedPackageIdsMenuItem_OnClick" />
                        <Separator />
                        <MenuItem x:Name="AddToBlacklistMenuItem"
                                  Header="{Binding [CtxAddToBlacklist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddToBlacklistMenuItem_OnClick" />
                        <MenuItem x:Name="AddSelectedToBlacklistMenuItem"
                                  Header="{Binding [CtxAddSelectedToBlacklist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddSelectedToBlacklistMenuItem_OnClick" />
                        <Separator />
                        <MenuItem x:Name="AddToWhitelistMenuItem"
                                  Header="{Binding [CtxAddToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveFromWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="AddSelectedToWhitelistMenuItem"
                                  Header="{Binding [CtxAddSelectedToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddSelectedToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveSelectedFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveSelectedFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveSelectedFromWhitelistMenuItem_OnClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>

                    <!--
                        Selection checkbox. Centered and purely a visual indicator
                        (IsHitTestVisible=False): the whole row is the click target via the
                        DataGrid's PreviewMouseLeftButtonUp handler, so clicking anywhere on a
                        row toggles its checkbox. This gives a clearly centered box and a large,
                        obvious hit area instead of a cramped ~16 px glyph.
                        The header checkbox is the interactive "select all": tri-state display
                        (checked / unchecked / indeterminate) driven by AreAllSelected.
                    -->
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False" IsReadOnly="True">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Style="{StaticResource ZenSelectAllCheckBoxStyle}"
                                      IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      IsThreeState="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding [SelectAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Focusable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                <!--
                    Template column gives us text trimming and a full-name tooltip.
                    Width="*" expands to fill all remaining space left by the fixed columns.
                -->
                    <DataGridTemplateColumn Header="{Binding [ColApplication], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="*"
                                            MinWidth="160"
                                            IsReadOnly="True"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Star" Width="13" Height="13"
                                                              Foreground="#FFC107"
                                                              VerticalAlignment="Top"
                                                              Margin="0,3,5,0"
                                                              Visibility="{Binding IsWhitelisted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="{Binding [WhitelistBadgeTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Padding="2,0"
                                                   ToolTip="{Binding DisplayName}" />
                                        <!-- Only present when the install failed; ordinary cell content, no RowDetails coercion issues -->
                                        <ContentPresenter x:Name="FailurePresenter"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource FailureReasonInlineTemplate}"
                                                          Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="FailurePresenter" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="190"
                                            IsReadOnly="True"
                                            SortMemberPath="WingetPackageId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WingetPackageId}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding WingetPackageId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColPublisher], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="150"
                                            IsReadOnly="True"
                                            SortMemberPath="Publisher">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Publisher}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding Publisher}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{Binding [ColCurrentVer], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Binding="{Binding CurrentVersion}"
                                        Width="110"
                                        IsReadOnly="True" />

                    <DataGridTextColumn Header="{Binding [ColNewVer], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Binding="{Binding AvailableVersion}"
                                        Width="110"
                                        IsReadOnly="True" />

                    <DataGridTemplateColumn Header="{Binding [ColStatus], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="110"
                                            IsReadOnly="True"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource StatusBadgeCellTemplate}" />

                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Padding="24"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [ProgramsEmptyTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [ProgramsEmptyBody], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Scan error panel: shown when a scan throws (network down, permissions, etc.) -->
            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Padding="24"
                    Visibility="{Binding HasScanFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="24" Height="24"
                                                 Foreground="{DynamicResource ZenBadgeFailedForegroundBrush}"
                                                 Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [ScanErrorTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding [ScanErrorBody], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Opacity="0.65"
                   FontSize="12"
                   Margin="0,8,0,0" />

    </Grid>
</UserControl>
