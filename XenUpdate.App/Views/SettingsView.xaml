<UserControl x:Class="XenUpdate.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:XenUpdate.App.Services"
             xmlns:controls="clr-namespace:XenUpdate.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ScrollViewer.RenderTransform>
            <TranslateTransform />
        </ScrollViewer.RenderTransform>
        <ScrollViewer.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </ScrollViewer.Triggers>
        <StackPanel Margin="24" MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="{Binding [SettingsTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitleStyle}" />

            <!-- General Settings Card -->
            <materialDesign:Card Style="{StaticResource ZenGlassCardStyle}" Padding="28" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsGeneral], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16" />

                    <CheckBox Content="{Binding [SettingsScanOnStartup], Source={x:Static loc:LocalizationManager.Instance}}"
                              IsChecked="{Binding Settings.ScanOnStartup}"
                              Margin="0,0,0,12" />

                    <CheckBox Content="{Binding [SettingsMinimizeToTray], Source={x:Static loc:LocalizationManager.Instance}}"
                              IsChecked="{Binding Settings.MinimizeToTray}"
                              Margin="0,0,0,20" />

                    <!-- Language -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [SettingsLanguage], Source={x:Static loc:LocalizationManager.Instance}}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" />
                        <ComboBox Grid.Column="2"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource ZenComboBoxStyle}"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding SelectedLanguageCode}" />
                    </Grid>

                    <!-- Theme toggle: one click switches Dark ↔ Light; saves automatically -->
                    <Border Margin="0,0,0,24"
                            Padding="14,10"
                            CornerRadius="8"
                            Background="{DynamicResource ZenGlassPanelBrush}"
                            BorderBrush="{DynamicResource ZenGlassBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [SettingsAppearance], Source={x:Static loc:LocalizationManager.Instance}}"
                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                           VerticalAlignment="Center" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="{Binding [SettingsCurrentlyDark], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="11" Opacity="0.55">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding [SettingsCurrentlyLight], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="11" Opacity="0.55">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ZenThemeToggleStyle}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{Binding [ThemeTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="WeatherSunny" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding [SwitchToLight], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="WeatherNight" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding [SwitchToDark], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding [SaveSettings], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />

                        <Button Content="{Binding [Reload], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Appearance Card: accent color, background photo + blur, cursor spotlight -->
            <materialDesign:Card Style="{StaticResource ZenGlassCardStyle}" Padding="28" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsAppearance], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,18" />

                    <!-- Theme palettes: each preset sets Primary/Secondary/Background together -->
                    <TextBlock Text="{Binding [SettingsAccentColor], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ThemePalettes}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Style="{x:Null}" strips MaterialDesignThemes' implicit Button style —
                                    without it, that style's own Height setter clipped this template's
                                    swatch+label content at the bottom (the exact "cut off" complaint).
                                    A local Height set directly here would have the same effect, but
                                    nulling the style is more robust against unrelated style changes later.
                                -->
                                <Button Style="{x:Null}"
                                        Width="78" Height="94"
                                        Margin="0,0,14,14"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="{Binding Name}"
                                        Command="{Binding DataContext.SelectThemePaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- Each preset is its own small glass-consistent card, matching
                                                 the app's card language instead of a bare floating swatch. -->
                                            <Border x:Name="Root" CornerRadius="14" Padding="10"
                                                    Background="{DynamicResource ZenSurfaceBrush}"
                                                    BorderBrush="{DynamicResource ZenGlassBorderBrush}"
                                                    BorderThickness="1.5">
                                                <StackPanel>
                                                    <!-- Three-color preview: background base, with primary/secondary corner dots -->
                                                    <Border CornerRadius="10" Height="42" Background="{Binding BackgroundSwatch}"
                                                            BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="1">
                                                        <Grid Margin="7">
                                                            <Ellipse Width="16" Height="16" Fill="{Binding PrimarySwatch}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                            <Ellipse Width="12" Height="12" Fill="{Binding SecondarySwatch}"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Opacity="0.75"
                                                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom Primary/Secondary/Background: swatch buttons expand the inline
                         picker panel below (our own SV-square + hue strip + hex box, not the
                         native OS dialog — that read as visibly out of place against the rest
                         of this glassmorphism UI). -->
                    <TextBlock Text="{Binding [SettingsCustomColors], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="11" FontWeight="Medium" Opacity="0.55"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [SettingsPrimaryHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Button Width="48" Height="48" Cursor="Hand" Padding="0"
                                    Command="{Binding OpenPrimaryColorPickerCommand}"
                                    ToolTip="{Binding Settings.AccentColorHex}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Background="{Binding PrimarySwatchBrush}"
                                                BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="2" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [SettingsSecondaryHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Grid>
                                <Button Width="48" Height="48" Cursor="Hand" Padding="0"
                                        Command="{Binding OpenSecondaryColorPickerCommand}"
                                        ToolTip="{Binding Settings.SecondaryColorHex}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="24" Background="{Binding SecondarySwatchBrush}"
                                                    BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="2" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="20" Height="20" Padding="0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-4,-4,0"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Visibility="{Binding HasCustomSecondary, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding ClearSecondaryColorCommand}"
                                        ToolTip="{Binding [SettingsResetSecondary], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding [SettingsBackgroundHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="11" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Button Width="48" Height="48" Cursor="Hand" Padding="0"
                                    Command="{Binding OpenBackgroundColorPickerCommand}"
                                    ToolTip="{Binding Settings.BackgroundColorHex}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24" Background="{Binding BackgroundSwatchBrush}"
                                                BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="2" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Captures the trio currently applied as a new saved theme tile below -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                VerticalAlignment="Bottom" Margin="28,0,0,6" Height="34"
                                Command="{Binding SaveCurrentPaletteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [SaveCurrentTheme], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- User-saved themes: same tile look as the built-in presets above, same apply
                         command, plus a hover ✕ to delete. Unlimited — stored locally in settings. -->
                    <ItemsControl ItemsSource="{Binding SavedPalettes}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="TileRoot" Margin="0,0,14,14">
                                    <Button Style="{x:Null}"
                                            Width="78" Height="94"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.SelectThemePaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Root" CornerRadius="14" Padding="10"
                                                        Background="{DynamicResource ZenSurfaceBrush}"
                                                        BorderBrush="{DynamicResource ZenGlassBorderBrush}"
                                                        BorderThickness="1.5">
                                                    <StackPanel>
                                                        <Border CornerRadius="10" Height="42" Background="{Binding BackgroundSwatch}"
                                                                BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="1">
                                                            <Grid Margin="7">
                                                                <Ellipse Width="16" Height="16" Fill="{Binding PrimarySwatch}"
                                                                         HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                                <Ellipse Width="12" Height="12" Fill="{Binding SecondarySwatch}"
                                                                         HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium" Opacity="0.75"
                                                                   HorizontalAlignment="Center" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource ZenSidebarHoverBrush}" />
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ZenPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Width="20" Height="20" Padding="0" Cursor="Hand"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-4,-4,0"
                                            Command="{Binding DataContext.RemoveSavedPaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding [RemoveSaved], Source={x:Static loc:LocalizationManager.Instance}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileRoot}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline picker panel: shown for whichever swatch was just clicked. Nothing
                         touches Settings until Confirm — Cancel just collapses this again. -->
                    <Border Visibility="{Binding IsColorPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource ZenGlassPanelBrush}"
                            BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ColorPickerTitle}"
                                       FontSize="11" FontWeight="Medium" Opacity="0.6"
                                       Margin="0,0,0,10" />
                            <controls:ColorPickerControl SelectedColor="{Binding EditingColor, Mode=TwoWay}" />

                            <!-- Saved swatches: click loads one into the picker; ✕ on hover deletes.
                                 Row only appears once at least one color has been saved. -->
                            <ItemsControl ItemsSource="{Binding SavedColors}" Margin="0,12,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SavedColors.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="260" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="SwatchRoot" Margin="0,0,8,8">
                                            <Button Width="26" Height="26" Padding="0" Cursor="Hand"
                                                    Command="{Binding DataContext.ApplySavedColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="13"
                                                                Background="{Binding Converter={StaticResource HexToBrushConverter}}"
                                                                BorderBrush="{DynamicResource ZenGlassBorderBrush}" BorderThickness="1.5" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Width="14" Height="14" Padding="0" Cursor="Hand"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-4,0"
                                                    Command="{Binding DataContext.RemoveSavedColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding [RemoveSaved], Source={x:Static loc:LocalizationManager.Instance}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=SwatchRoot}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="CloseCircle" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="34" Padding="10,0"
                                        Command="{Binding SaveEditingColorCommand}"
                                        ToolTip="{Binding [SaveColorTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" />
                                </Button>
                                <Button Grid.Column="2"
                                        Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Command="{Binding CancelColorPickerCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,0,8,0" />
                                <Button Grid.Column="3"
                                        Content="{Binding [ApplyAccentColor], Source={x:Static loc:LocalizationManager.Instance}}"
                                        Command="{Binding ConfirmColorPickerCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Background photo -->
                    <TextBlock Text="{Binding [SettingsBackgroundPhoto], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [SettingsBackgroundPhotoDesc], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="{Binding [ChooseBackgroundImage], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding ChooseBackgroundImageCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding [ClearBackgroundImage], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding ClearBackgroundImageCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding Settings.BackgroundImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding Settings.BackgroundImagePath, Converter={StaticResource NullToVisibilityConverter}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="{Binding [SettingsBlurStrength], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                   Margin="0,0,0,4" />
                        <Slider Minimum="0" Maximum="80"
                                Value="{Binding Settings.BackgroundBlurRadius}" />
                    </StackPanel>

                    <!-- Cursor spotlight -->
                    <CheckBox Content="{Binding [SettingsSpotlightEffect], Source={x:Static loc:LocalizationManager.Instance}}"
                              IsChecked="{Binding Settings.SpotlightEnabled}" />
                    <TextBlock Text="{Binding [SettingsSpotlightEffectDesc], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.55" FontSize="11" Margin="28,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Blacklist Card -->
            <materialDesign:Card Style="{StaticResource ZenGlassCardStyle}" Padding="24" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding [BlacklistTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [BlacklistDesc], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding NewBlacklistPackageId, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{Binding [BlacklistPackageIdHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                 Margin="0,0,8,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding NewBlacklistReason, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{Binding [BlacklistReasonHint], Source={x:Static loc:LocalizationManager.Instance}}"
                                 Margin="0,0,8,0" />

                        <Button Grid.Column="2"
                                Content="{Binding [Add], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding AddBlacklistEntryCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </Grid>

                    <!-- Same premium glass chrome + Zen DataGrid styling as the Programs/Updates tables. -->
                    <Border Style="{StaticResource ZenDataGridChromeStyle}">
                        <DataGrid x:Name="BlacklistDataGrid"
                                  ItemsSource="{Binding BlacklistEntries}"
                                  SelectedItem="{Binding SelectedBlacklistEntry}"
                                  SelectionMode="Extended"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MinHeight="140"
                                  Background="{DynamicResource ZenDataGridSurfaceBrush}"
                                  Foreground="{DynamicResource ZenTextBrush}"
                                  ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource ZenDataGridRowStyle}"
                                  CellStyle="{StaticResource ZenDataGridCellStyle}"
                                  materialDesign:DataGridAssist.CellPadding="8 6"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [CtxCopyPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                              Click="CopyPackageIdMenuItem_OnClick" />
                                    <MenuItem Header="{Binding [CtxCopySelectedIds], Source={x:Static loc:LocalizationManager.Instance}}"
                                              Click="CopySelectedPackageIdsMenuItem_OnClick" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [ColPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Binding="{Binding PackageId}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="{Binding [ColReason], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Binding="{Binding Reason}"
                                                    Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Content="{Binding [RemoveSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                            Click="RemoveSelectedButton_OnClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Whitelist Card: updates pre-approved to install themselves the moment the app is online. -->
            <materialDesign:Card Style="{StaticResource ZenGlassCardStyle}" Padding="24" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding [WhitelistTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [WhitelistDesc], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Border Style="{StaticResource ZenDataGridChromeStyle}">
                        <DataGrid x:Name="WhitelistDataGrid"
                                  ItemsSource="{Binding WhitelistEntries}"
                                  SelectedItem="{Binding SelectedWhitelistEntry}"
                                  SelectionMode="Extended"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  MinHeight="140"
                                  Background="{DynamicResource ZenDataGridSurfaceBrush}"
                                  Foreground="{DynamicResource ZenTextBrush}"
                                  ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource ZenDataGridRowStyle}"
                                  CellStyle="{StaticResource ZenDataGridCellStyle}"
                                  materialDesign:DataGridAssist.CellPadding="8 6"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [CtxCopyPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                              Click="CopyWhitelistIdMenuItem_OnClick" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [ColDisplayName], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Binding="{Binding DisplayName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="{Binding [ColSource], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Binding="{Binding Source}"
                                                    Width="1*" />
                                <DataGridTextColumn Header="{Binding [ColPackageId], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Binding="{Binding Id}"
                                                    Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Content="{Binding [RemoveSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                            Click="RemoveSelectedWhitelistButton_OnClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Logs Card: the live log console embedded right on the page, so the entries stay
                 reachable even if the separate log window is closed (or was never opened).
                 Binds the same LogConsoleViewModel singleton the LogViewerWindow shows. -->
            <materialDesign:Card Style="{StaticResource ZenGlassCardStyle}" Padding="24" Margin="0,12,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding [SettingsLogsTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [SettingsLogsDesc], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Border CornerRadius="8"
                            Background="{DynamicResource ZenLogDrawerMatteBrush}"
                            BorderBrush="{DynamicResource ZenDividerBrush}"
                            BorderThickness="1"
                            Padding="8"
                            MaxHeight="260">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogConsole.Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="2,0,0,0" Padding="9,4" Margin="0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ZenMutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ZenWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ZenErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource ZenMutedTextBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="Cascadia Code, Consolas, monospace"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource ZenTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <TextBlock Text="{Binding StatusMessage}"
                       Opacity="0.65"
                       FontSize="12"
                       Margin="0,12,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
