<Window x:Class="XenUpdate.App.Views.UpdateQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:XenUpdate.App.Services"
        xmlns:vm="clr-namespace:XenUpdate.App.ViewModels"
        Title="Update Queue"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Border Width="420"
            CornerRadius="16"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            TextElement.Foreground="{DynamicResource MaterialDesignBody}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.65" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource MaterialDesignToolBarBackground}"
                    CornerRadius="16,16,0,0"
                    Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistCheck"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="{Binding [UpdateQueue], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="32" Height="32" Padding="0"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- Queue list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="16,12,16,0"
                          MinHeight="60"
                          MaxHeight="340">
                <ItemsControl ItemsSource="{Binding UpdateQueue}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignChipBackground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#AA4F46E5" Offset="0" />
                                                            <GradientStop Color="#AA1D4ED8" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                <Setter Property="Background" Value="#6634A853" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Background" Value="#66E53935" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold" />
                                        <Border Margin="0,8,0,0"
                                                CornerRadius="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00FFFF" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                                            </Border.Effect>
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Height="10"
                                                         Background="#22FFFFFF"
                                                         Value="{Binding ProgressPercentage}">
                                                <ProgressBar.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00FFFF" Offset="0" />
                                                        <GradientStop Color="#7C3AED" Offset="1" />
                                                    </LinearGradientBrush>
                                                </ProgressBar.Foreground>
                                            </ProgressBar>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                  Width="20" Height="20"
                                                                  Foreground="#4CAF50"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,4,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <materialDesign:PackIcon Kind="AlertCircle"
                                                                  Width="20" Height="20"
                                                                  Foreground="#E53935"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,4,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <Button Width="32" Height="32" Padding="0"
                                                Command="{Binding DataContext.RemoveFromQueueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Remove">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="{Binding [QueueEmpty], Source={x:Static loc:LocalizationManager.Instance}}"
                       HorizontalAlignment="Center"
                       Margin="0,24"
                       Opacity="0.55">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateQueue.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Action buttons -->
            <Grid Grid.Row="2" Margin="16,12,16,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding StartInstallQueueCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="44">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Play"
                                                 Width="18" Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StartInstall], Source={x:Static loc:LocalizationManager.Instance}}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding RetryFailedUpdatesCommand}"
                        Height="44"
                        Width="44"
                        Padding="0"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="#FF9800"
                        ToolTip="{Binding [Retry], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding CancelInstallationCommand}"
                        Height="44"
                        Width="44"
                        Padding="0"
                        IsEnabled="{Binding IsInstalling}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Foreground="#E53935"
                        ToolTip="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialDesign:PackIcon Kind="Cancel" Width="20" Height="20" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
