<UserControl x:Class="XenUpdate.App.Views.WindowsUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:XenUpdate.App.Services">
    <!--
        DataContext is set automatically by MainWindow's DataTemplate binding.
        DataContext type: WindowsUpdatesViewModel
    -->
    <Grid Margin="24">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageEnterStoryboard}" />
            </EventTrigger>
        </Grid.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding [WindowsUpdatesTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />

            <!--
                Action toolbar sits top-right, away from the grid's select-all checkbox
                (top-left of the DataGrid header below). It used to sit directly above that
                checkbox, so a click aimed at "select all" could misfire into "Scan".
                Only the two permanent buttons live here — Cancel and the scan progress bar
                used to sit in this same row and, by appearing/disappearing, changed this
                Auto-width column's total size and shoved these buttons sideways. They now
                live in their own row (Grid.Row="1") below, which can grow or shrink without
                touching this row's layout at all.
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="{Binding [CheckForUpdates], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0" />

                <Button Content="{Binding [InstallSelected], Source={x:Static loc:LocalizationManager.Instance}}"
                        Command="{Binding InstallSelectedCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />

            </StackPanel>
        </Grid>

        <!--
            Scan-busy row: a spinner + "Scanning…" label, then Cancel. Kept out of the row
            above so their appearing/disappearing never shifts the permanent action buttons.
            A circular spinner (not a thin linear bar) plus explicit text: a slim indeterminate
            line reads as "a barely-visible sliver" at a glance, which is exactly what a user
            reported — this is unambiguous even glanced at quickly. Bound to IsScanning only —
            install progress uses the dedicated feedback panel further down instead.
        -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="18" Height="18"
                             Foreground="{DynamicResource ZenPrimaryBrush}"
                             Margin="0,0,8,0" />
                <TextBlock Text="{Binding [ScanningShort], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="13" FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ScanProgressPercent, StringFormat={}{0}%}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ZenPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}}"
                    Command="{Binding CancelScanCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="12,0,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource ZenGlassPanelStyle}"
                Margin="0,0,0,12"
                Padding="12"
                Visibility="{Binding IsInstallBatchRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding CurrentBatchProgressText}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentUpdateTitle, StringFormat=Current update: {0}}"
                           Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentKbArticle, StringFormat=KB: {0}}"
                           Margin="0,0,0,6"
                           Visibility="{Binding HasCurrentKbArticle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ProgressBar IsIndeterminate="True"
                             Height="6"
                             Margin="0,0,0,6" />
                <TextBlock Text="{Binding CurrentInstallDetailText}"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource ZenDataGridChromeStyle}"
                    Visibility="{Binding HasUpdates, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid x:Name="WindowsUpdatesDataGrid"
                      ItemsSource="{Binding Updates}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ClipboardCopyMode="ExcludeHeader"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Background="{DynamicResource ZenDataGridSurfaceBrush}"
                      Foreground="{DynamicResource ZenTextBrush}"
                      ColumnHeaderStyle="{StaticResource ZenDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource ZenDataGridRowStyle}"
                      CellStyle="{StaticResource ZenDataGridCellStyle}"
                      PreviewMouseRightButtonDown="WindowsUpdatesDataGrid_OnPreviewMouseRightButtonDown"
                      materialDesign:DataGridAssist.CellPadding="8 6"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8 6">
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="WindowsUpdatesContextMenu_OnOpened">
                        <MenuItem x:Name="CopyUpdateTitleMenuItem"
                                  Header="{Binding [CtxCopyUpdateTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyUpdateTitleMenuItem_OnClick" />
                        <MenuItem x:Name="CopyKbArticleMenuItem"
                                  Header="{Binding [CtxCopyKbArticle], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyKbArticleMenuItem_OnClick" />
                        <MenuItem x:Name="CopyUpdateTitleAndKbMenuItem"
                                  Header="{Binding [CtxCopyUpdateTitleAndKb], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopyUpdateTitleAndKbMenuItem_OnClick" />
                        <MenuItem x:Name="CopySelectedUpdateTitlesMenuItem"
                                  Header="{Binding [CtxCopySelectedTitles], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="CopySelectedUpdateTitlesMenuItem_OnClick" />
                        <Separator />
                        <MenuItem x:Name="AddToWhitelistMenuItem"
                                  Header="{Binding [CtxAddToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveFromWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="AddSelectedToWhitelistMenuItem"
                                  Header="{Binding [CtxAddSelectedToWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="AddSelectedToWhitelistMenuItem_OnClick" />
                        <MenuItem x:Name="RemoveSelectedFromWhitelistMenuItem"
                                  Header="{Binding [CtxRemoveSelectedFromWhitelist], Source={x:Static loc:LocalizationManager.Instance}}"
                                  Click="RemoveSelectedFromWhitelistMenuItem_OnClick" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>

                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="40"
                                            CanUserSort="False"
                                            IsReadOnly="False">
                        <DataGridCheckBoxColumn.Header>
                            <!-- Select-all: tri-state display driven by AreAllSelected on the page VM -->
                            <CheckBox Style="{StaticResource ZenSelectAllCheckBoxStyle}"
                                      IsChecked="{Binding DataContext.AreAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      IsThreeState="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="{Binding [SelectAllTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>

                    <DataGridTemplateColumn Header="{Binding [ColUpdate], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="*"
                                            IsReadOnly="True"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Star" Width="13" Height="13"
                                                              Foreground="#FFC107"
                                                              VerticalAlignment="Top"
                                                              Margin="0,3,5,0"
                                                              Visibility="{Binding IsWhitelisted, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              ToolTip="{Binding [WhitelistBadgeTooltip], Source={x:Static loc:LocalizationManager.Instance}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Padding="2,0"
                                                   ToolTip="{Binding DisplayName}" />
                                        <ContentPresenter x:Name="FailurePresenter"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource FailureReasonInlineTemplate}"
                                                          Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                        <Setter TargetName="FailurePresenter" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColKbArticle], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="120"
                                            IsReadOnly="True"
                                            SortMemberPath="KbArticleId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KbArticleId}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding KbArticleId}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColSeverity], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="110"
                                            IsReadOnly="True"
                                            SortMemberPath="MsrcSeverity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MsrcSeverity}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Padding="2,0"
                                           ToolTip="{Binding MsrcSeverity}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{Binding [ColStatus], Source={x:Static loc:LocalizationManager.Instance}}"
                                            Width="110"
                                            IsReadOnly="True"
                                            SortMemberPath="Status"
                                            CellTemplate="{StaticResource StatusBadgeCellTemplate}" />

                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <Border Style="{StaticResource ZenGlassPanelStyle}"
                    Padding="24"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding [WindowsUpdatesEmptyTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [WindowsUpdatesEmptyBody], Source={x:Static loc:LocalizationManager.Instance}}"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Opacity="0.65"
                   FontSize="12"
                   Margin="0,8,0,0" />

    </Grid>
</UserControl>
